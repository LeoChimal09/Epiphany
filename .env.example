# Copy to .env (ignored by git) and replace the placeholders. Never commit real values.
# One root .env is shared by the dashboard (apps/web) and worker (apps/worker).
# On Railway, set these as service variables instead of using a file.

# ── Database (required) ───────────────────────────────────────────────
# Create the local directory first: mkdir -p data (SQLite files/sidecars are ignored).
# Railway: file:/data/epiphany.sqlite with a persistent volume mounted at /data.
# Both processes must use this same local file on the same machine; no remote/memory database.
DATABASE_URL="file:./data/epiphany.sqlite"

# ── App ───────────────────────────────────────────────────────────────
APP_TIMEZONE="America/Chicago"            # IANA timezone for the owner's day
PORT="3000"                              # production web port; Railway supplies PORT
WORKER_HEALTH_PORT="3001"                 # worker /health; must differ from PORT

# SQLite tests use isolated files, never the configured application database.
# Legacy MySQL import/rollback tooling only: keep old credentials outside this example.

# ── Discord bot ──────────────────────────────────────────────────────
# Needs the Message Content intent for #assistant and DMs. Do not grant Administrator.
DISCORD_BOT_TOKEN=""
# Your Discord user ID (Developer Mode > right-click your name > Copy User ID).
# The only account allowed to use Epi.
OWNER_DISCORD_USER_ID=""

# ── Dashboard sign-in (Discord login; owner only) ─────────────────────
# Create an application at https://discord.com/developers/applications, then OAuth2 > Redirects:
#   add  <APP_URL>/api/auth/discord/callback   (e.g. http://localhost:3000/api/auth/discord/callback)
# Only the Discord account in OWNER_DISCORD_USER_ID can sign in. Leave these blank to disable sign-in.
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
APP_URL="http://localhost:3000"           # where the dashboard is served; used for the redirect URI
# Development bypass: set to "dev" to sign in without Discord (bun run dev, on localhost only; it is
# refused in production builds). Leave blank to use Discord. With "dev", the Discord values above are
# optional, and OWNER_DISCORD_USER_ID (if set) makes the bypass use your real owner record.
ENV_BYPASS=""

# ── AI provider (read by the dashboard's "Ask Epi") ──────────────────
# Only the key is needed. Without it the chat shows setup help and everything else keeps working.
# Use a dedicated key/project with its own spending limit in the OpenAI dashboard.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
# Prices, endpoint, budget, and token caps have safe application defaults.

# Optional cost-control overrides (normally leave unset):
# AI_MONTHLY_BUDGET_USD="10"
# AI_BUDGET_WARN_PERCENT="80"
# AI_MAX_INPUT_TOKENS="8000"
# AI_MAX_OUTPUT_TOKENS="4000"

# ── Google Calendar (read by the dashboard and the worker: Goal 11) ───
# Optional. All three must be set to turn it on; leave them blank to keep calendars off (nothing breaks).
# Setup steps (Google Cloud console, redirect URI, test user): docs/calendar.md.
# Redirect URI to register: <APP_URL>/api/google/callback
# Use a test calendar for development; Epiphany writes only to its own dedicated "Epiphany" calendar.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Encrypts the saved Google tokens at rest (AES-256-GCM): 32 random bytes as base64.
# Generate with: openssl rand -base64 32   (keep a copy outside Railway; losing it means reconnecting)
TOKEN_ENCRYPTION_KEY=""

# ── Backups (not read yet: Goal 19) ───────────────────────────────────
# Daily encrypted off-platform backups. The storage provider is not chosen yet.
BACKUP_ENCRYPTION_KEY=""                # store a recovery copy outside Railway

# Speech providers for voice (Goals 20/21) and Microsoft calendar access (Goal 23) are undecided.

# --- Voice (optional; text works without any of this) ---
# Audio messages and live voice use OPENAI_API_KEY for transcription. Spoken replies prefer ElevenLabs
# and fall back to OpenAI speech. Voice has its own monthly spending limit, separate from the text budget.
# ELEVENLABS_API_KEY=""
# ELEVENLABS_VOICE_ID=""
# VOICE_MONTHLY_BUDGET_USD="5"
# VOICE_BUDGET_WARN_PERCENT="80"
# AUDIO_MAX_BYTES="8388608"
# AUDIO_MAX_SECONDS="300"
# Prices used to meter spending (USD): check them against the providers' current price pages.
# VOICE_TRANSCRIPTION_USD_PER_MINUTE="0.006"
# VOICE_TTS_ELEVENLABS_USD_PER_1K_CHARS="0.3"
# VOICE_TTS_OPENAI_USD_PER_1K_CHARS="0.015"
